# XiaoWork Nav deployment configuration.
# Copy to `.env` and edit. NEVER commit the real `.env` file.

# --- Image & version -------------------------------------------------------
# Image repository (GHCR) and the immutable version tag to run.
XN_IMAGE=ghcr.io/xiaowork-dev/xiaowork-nav
APP_VERSION=latest
XN_CONTAINER_NAME=xiaowork-nav

# --- Data persistence (host path mounted to /data in the container) --------
# This directory holds the SQLite database, uploaded icons and backups.
# It is never overwritten by image updates.
XN_DATA_HOST_DIR=./data

# --- Network ---------------------------------------------------------------
# Standalone mode: host bind address and published port.
# Keep 127.0.0.1 when a reverse proxy on the same host handles TLS.
XN_BIND_ADDR=127.0.0.1
XN_PUBLISH_PORT=8787

# NPM mode only: name of the existing external Docker network shared with NPM.
# Leave empty for standalone mode.
XN_PROXY_NETWORK=

# --- Runtime options -------------------------------------------------------
XN_LOG_LEVEL=info
XN_ALLOW_GUEST_ACCESS=true

# Timezone for log timestamps (e.g. Asia/Shanghai).
TZ=UTC

# Mark the session cookie Secure (HTTPS only). Keep true in production;
# set to false only for local HTTP development.
XN_SECURE_COOKIE=true

# Number of backup snapshots to retain (0 = unlimited).
XN_BACKUP_KEEP=5

# GitHub repository ("owner/name") used by the admin update check.
# Leave empty to disable remote version checks.
XN_UPDATE_REPO=

# Comma-separated trusted proxy CIDRs whose X-Forwarded-* headers are honored.
XN_TRUSTED_PROXIES=
# Comma-separated allowed CORS origins (development only; leave empty in prod).
XN_ALLOWED_ORIGINS=

# --- Optional application overrides ----------------------------------------
# XN_SESSION_TTL_HOURS=168
# XN_SESSION_COOKIE=xiaowork_session
